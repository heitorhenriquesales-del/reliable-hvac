# Set this to the final public URL for canonical metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Server-only Resend credentials for direct quote-form email delivery.
# Add a verified sender address in Resend before setting this in Vercel.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Password for the private client gallery manager (/gallery-admin).
# Use a unique password with at least 20 characters; never commit the real value.
GALLERY_ADMIN_PASSWORD=
