# Set this to the final public URL for canonical metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Server-only Resend credentials for direct quote-form email delivery.
# Add a verified sender address in Resend before setting this in Vercel.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Password for the private client gallery manager (/gallery-admin).
# Use a unique password with at least 20 characters; never commit the real value.
GALLERY_ADMIN_PASSWORD=

# Vercel Blob storage. Create/connect a Blob store in Vercel Storage; Vercel will
# provide this token to the project environment automatically. Do not commit it.
BLOB_READ_WRITE_TOKEN=

# Google Business Profile API (server-only). Use OAuth credentials authorized
# by an account with access to the verified Reliable HVAC location.
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
